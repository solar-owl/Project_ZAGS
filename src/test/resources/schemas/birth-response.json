{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["data", "requestId"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["applicantid", "citizenid", "applicationid", "birthcertificateid"],
      "properties": {
        "applicantid":        { "type": "integer", "minimum": 1 },
        "citizenid":          { "type": "integer", "minimum": 1 },
        "applicationid":      { "type": "integer", "minimum": 1 },
        "birthcertificateid": { "type": "integer", "minimum": 1 }
      }
    },
    "requestId": { "type": "string", "format": "uuid" }
  }
}