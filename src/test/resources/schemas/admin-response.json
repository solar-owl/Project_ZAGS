{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["data", "requestId"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "required": ["staffid"],
      "additionalProperties": false,
      "properties": {
        "staffid": { "type": "integer", "minimum": 1 }
      }
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    }
  }
}