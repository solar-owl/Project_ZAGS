{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["data", "requestId"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "dateofapplication",
        "kindofapplication",
        "statusofapplication"
      ],
      "additionalProperties": false,
      "properties": {
        "dateofapplication":   { "type": "string", "format": "date-time" },
        "kindofapplication":   { "type": "string", "minLength": 1 },
        "statusofapplication": {
          "type": "string",
          "enum": ["under consideration", "approved", "rejected"]
        }
      }
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    }
  }
}