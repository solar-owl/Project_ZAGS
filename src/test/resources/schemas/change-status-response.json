{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["data", "requestId"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "applicationid",
        "citizenid",
        "applicantid",
        "dateofapplication",
        "kindofapplication",
        "statusofapplication",
        "channel"
      ],
      "additionalProperties": false,
      "properties": {
        "applicationid":       { "type": "integer", "minimum": 1 },
        "citizenid":           { "type": "integer", "minimum": 1 },
        "applicantid":         { "type": "integer", "minimum": 1 },
        "staffid":             { "type": ["integer", "null"] },
        "dateofapplication":   { "type": "string", "format": "date-time" },
        "kindofapplication":   { "type": "string", "minLength": 1 },
        "statusofapplication": {
          "type": "string",
          "enum": ["under consideration", "approved", "rejected"]
        },
        "channel":             { "type": "string" },
        "image":               { "type": ["string", "null"] }
      }
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    }
  }
}